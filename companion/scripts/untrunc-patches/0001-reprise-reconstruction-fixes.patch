 	}
 
+	// The first slice of a picture defines the sample. Its size follows scene content, which can differ from the
+	// healthy reference, so only reject it when it is implausibly large; the bound still guards slice merging.
+	bool firstSliceTooLarge(const char *label, uint length, uint additional) {
+		uint64_t limit = 8 * (uint64_t)maxAllowedPktSz();
+		if (limit && (uint64_t)length + additional > limit) {
+			logg(V, "first ", label, "-slice implausibly large: ", length + additional, " > ", limit, "\n");
+			return true;
+		}
+		return false;
+	}
+
 	bool wouldExceed(const char *label, uint length, uint additional, bool is_keyframe) {
 		if (exceedsAllowed(length + additional, is_keyframe)) {
 			logg(V, "new partial ", label, "-length would exceed upper_bound: ", length, " + ", additional, " = ", length + additional, " > ", getUpperLimit(is_keyframe), "  // is_keyframe=", is_keyframe, "\n");
